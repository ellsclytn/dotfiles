input "type:keyboard" {
  xkb_options caps:ctrl_modifier
}

input "type:pointer" {
  accel_profile flat
  pointer_accel 0
}

input "type:touchpad" {
  tap enabled
}

output * {
  background ~/Pictures/wallpaper.png fill
  {{#if laptop}}
  max_render_time 15
  {{/if}}
}

output DP-1 {
  adaptive_sync on
}
